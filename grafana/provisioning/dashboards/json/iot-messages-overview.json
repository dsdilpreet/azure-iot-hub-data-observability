{
  "title": "IoT Hub Messages Overview",
  "uid": "iot-messages-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1h",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "query": "SELECT DISTINCT connection_device_id FROM iot_messages WHERE connection_device_id IS NOT NULL ORDER BY 1",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": "all",
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total messages per device",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "targets": [
        {
          "rawSql": "SELECT connection_device_id AS \"device\", count(*) AS \"total_messages\" FROM iot_messages WHERE $__timeFilter(enqueued_time) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              { "fieldName": "device", "handlerKey": "field.name" },
              { "fieldName": "total_messages", "handlerKey": "field.value" }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Total messages per schema type ($device)",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "targets": [
        {
          "rawSql": "SELECT iothub_message_schema AS \"schema\", count(*) AS \"total_messages\" FROM iot_messages WHERE $__timeFilter(enqueued_time) AND ('$device' = 'all' OR connection_device_id = '$device') GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              { "fieldName": "schema", "handlerKey": "field.name" },
              { "fieldName": "total_messages", "handlerKey": "field.value" }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Total messages per schema type ($device)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "barAlignment": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "maxDataPoints": 30,
      "targets": [
        {
          "rawSql": "SELECT time_bucket('$__interval', enqueued_time) AS time, iothub_message_schema AS \"metric\", count(*) AS \"total_messages\" FROM iot_messages WHERE $__timeFilter(enqueued_time) AND ('$device' = 'all' OR connection_device_id = '$device') GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total messages per device per schema type",
      "type": "table",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "targets": [
        {
          "rawSql": "SELECT connection_device_id AS \"device\", iothub_message_schema AS \"schema\", count(*) AS \"total_messages\" FROM iot_messages WHERE $__timeFilter(enqueued_time) GROUP BY 1, 2 ORDER BY 1, 2",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "rowField": "device",
            "columnField": "schema",
            "valueField": "total_messages"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "reducer": "sum",
            "alias": "total_messages"
          }
        }
      ]
    }
  ]
}